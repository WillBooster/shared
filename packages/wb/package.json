{
  "name": "@willbooster/wb",
  "version": "0.0.0-semantically-released",
  "description": "CLI tool for WillBooster projects",
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/shared.git",
    "directory": "packages/wb"
  },
  "bin": {
    "wb": "bin/index.js"
  },
  "files": [
    "bin/",
    "docker/",
    "dist/"
  ],
  "type": "module",
  "exports": {
    "./bin/*": "./bin/*",
    "./release-plugin": "./dist/releasePlugin.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run start buildIfNeeded --command 'bun build-ts app --input src/index.ts src/releasePlugin.ts src/gc.ts'",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "start": "bun src/index.ts",
    "start-prod": "bun run build && bun wb",
    "test": "bun wb test",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "@textlint-rule/textlint-rule-no-invalid-control-character": "3.0.0",
    "@textlint/kernel": "15.8.0",
    "@textlint/module-interop": "15.8.0",
    "@textlint/textlint-plugin-markdown": "15.8.0",
    "chalk": "6.0.1",
    "code-gauge": "10.3.0",
    "dotenv": "18.0.8",
    "dotenv-expand": "13.0.0",
    "fast-glob": "3.3.3",
    "fastest-levenshtein": "1.0.16",
    "globby": "16.2.4",
    "jsonc-parser": "3.3.1",
    "minimal-promise-pool": "6.0.4",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "textlint-filter-rule-node-types": "1.1.0",
    "textlint-rule-ja-space-between-half-and-full-width": "3.0.4",
    "textlint-rule-no-zero-width-spaces": "1.0.1",
    "yargs": "18.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@slidev/parser": "53.0.0",
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/node-ts": "23.6.4",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "@types/yargs": "17.0.35",
    "@willbooster/oxlint-config": "1.4.9",
    "at-decorators": "7.1.2",
    "build-ts": "21.0.29",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "textlint-rule-no-hankaku-kana": "2.0.1",
    "type-fest": "5.10.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.0.0"
  }
}
