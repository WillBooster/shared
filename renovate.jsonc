{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/wb/docker/bash/install-litestream\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=\\$\\{[A-Z_]+:-(?<currentValue>[^}]+)\\}",
      ],
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
  ],
  "packageRules": [
    // Consumers run install-litestream.sh from the published wb package, so a bump must release wb: a `chore`
    // commit, the default type for a custom-manager dependency or in the shared minor group, releases nothing.
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["benbjohnson/litestream"],
      "semanticCommitType": "fix",
      "groupName": "litestream",
      "groupSlug": "litestream",
    },
    // 11.0.0: Version 11 requires web-tree-sitter ^15 (https://github.com/WillBooster/tree-sitter-bash/blob/v11.0.0/package.json), but wbfy uses 2.0.33; loading the grammar fails with an incompatible language ABI.
    // 12.0.0: Version 12 requires web-tree-sitter ^17.0.1 and its grammar fails to load with wbfy’s pinned 2.0.33 runtime: incompatible language ABI 0x5742000c versus 0x57420001. https://github.com/WillBooster/tree-sitter-bash/pull/117
    // 11.0.1: Version 11.0.1 requires web-tree-sitter 15 or 16, but wbfy loads the grammar with 2.0.33; the grammar's runtime ABI changed since 4.0.4 (https://github.com/WillBooster/tree-sitter-bash/releases/tag/v5.0.0, https://github.com/WillBooster/tree-sitter-bash/pull/101, https://github.com/WillBooster/tree-sitter-bash/pull/116). Version 12 targets a newer runtime, not version 2 (https://github.com/WillBooster/tree-sitter-bash/pull/117).
    // 10.0.0: Version 10 requires web-tree-sitter ^15.0.0 and uses the runtime 15 parser ABI, but wbfy loads its grammar with web-tree-sitter 2.0.33. The newer version 12 also requires a newer runtime, so it does not fix compatibility with this repository. https://github.com/WillBooster/tree-sitter-bash/pull/101 https://github.com/WillBooster/shared/pull/1613
    {
      "matchPackageNames": ["@willbooster/tree-sitter-bash"],
      "allowedVersions": "!/^(11\\.0\\.0|12\\.0\\.0|11\\.0\\.1|10\\.0\\.0)$/",
    },
    // 16.0.2: Version 16.0.2 rejects the pinned Bash grammar ABI 0x57420001 at startup; it requires ABI 0x5742000b (https://github.com/WillBooster/tree-sitter/pull/278).
    // 16.0.1: Version 16.0.1 requires grammar ABI 0x5742000b and rejects the Bash 4.0.4 grammar pinned by wbfy (ABI 0x57420001), preventing shell parser initialization; https://github.com/WillBooster/tree-sitter/pull/278 and https://github.com/WillBooster/shared/pull/1591.
    // 18.0.2: Version 18.0.2 rejects wbfy's pinned Bash 4.0.4 grammar: it expects ABI 0x5742000c but the grammar has 0x57420001, preventing shell parser initialization. Earlier ABI incompatibility is documented at https://github.com/WillBooster/shared/pull/1593 and https://github.com/WillBooster/tree-sitter/pull/278.
    // 18.0.1: Version 18.0.1 rejects wbfy's Bash 4.0.4 grammar: runtime ABI 0x5742000c does not match grammar ABI 0x57420001. Version 18.0.2 has the same incompatibility: https://github.com/WillBooster/shared/pull/1616; ABI changes: https://github.com/WillBooster/tree-sitter/pull/278.
    {
      "matchPackageNames": ["@willbooster/web-tree-sitter"],
      "allowedVersions": "!/^(16\\.0\\.2|16\\.0\\.1|18\\.0\\.2|18\\.0\\.1)$/",
    },
  ],
}
