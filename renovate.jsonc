{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/wb/docker/bash/install-litestream\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=\\$\\{[A-Z_]+:-(?<currentValue>[^}]+)\\}",
      ],
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
  ],
  "packageRules": [
    // Consumers run install-litestream.sh from the published wb package, so a bump must release wb: a `chore`
    // commit, the default type for a custom-manager dependency or in the shared minor group, releases nothing.
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["benbjohnson/litestream"],
      "semanticCommitType": "fix",
      "groupName": "litestream",
      "groupSlug": "litestream",
    },
    // 15.0.3: Version 15 uses grammar ABI 0x5742000d and requires web-tree-sitter 23, but wbfy loads it with runtime 20 (ABI 0x5742000c); a coordinated runtime upgrade is required: https://github.com/WillBooster/tree-sitter-bash/pull/133 and https://github.com/WillBooster/shared/pull/1647.
    {
      "matchPackageNames": ["@willbooster/tree-sitter-bash"],
      "allowedVersions": "!/^15\\.0\\.3$/",
    },
    // 23.0.4: The v22+ runtime requires grammar ABI 0x5742000d, but wbfy loads tree-sitter-bash 14.0.0 with ABI 0x5742000c; upgrading the grammar is also required. https://github.com/WillBooster/tree-sitter/pull/366 https://github.com/WillBooster/shared/pull/1675
    {
      "matchPackageNames": ["@willbooster/web-tree-sitter"],
      "allowedVersions": "!/^23\\.0\\.4$/",
    },
    // 6.0.3: Version 6 requires exactOptionalPropertyTypes: true, but the wb and wbfy TypeScript configurations do not enable it; using this version requires a configuration change (https://github.com/sindresorhus/type-fest/releases/tag/v6.0.0).
    {
      "matchPackageNames": ["type-fest"],
      "allowedVersions": "!/^6\\.0\\.3$/",
    },
  ],
}
